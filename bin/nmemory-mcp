#!/bin/sh
set -eu

die() {
  status=$1
  shift
  printf '%s\n' "nmemory launcher: $*" >&2
  exit "$status"
}

if [ -n "${NOTT_NMEMORY_BIN:-}" ]; then
  resolved=$NOTT_NMEMORY_BIN
  unresolved_status=126
  [ -f "$resolved" ] && [ -x "$resolved" ] || \
    die 126 'NOTT_NMEMORY_BIN does not name an executable file'
else
  resolved=$(command -v nmemory 2>/dev/null) || \
    die 127 'nmemory is unavailable; install it on PATH or set NOTT_NMEMORY_BIN'
  unresolved_status=127
  [ -n "$resolved" ] && [ -x "$resolved" ] || \
    die 127 'nmemory resolved to a non-executable target'
fi

case "$resolved" in
  */*) ;;
  *) resolved=./$resolved ;;
esac

self_target=false
[ "$resolved" != "$0" ] || self_target=true
if [ "$self_target" = false ] && [ "$resolved" -ef "$0" ] 2>/dev/null; then
  self_target=true
fi
[ "$self_target" = false ] || \
  die "$unresolved_status" 'nmemory resolved to the launcher itself'

[ "${1:-}" != --probe ] || exit 0
exec "$resolved" "$@"
