      "voiceLintAdditional": [
        "chmod",
        "date",
        "grep",
        "jq",
        "mkdir",
        "mktemp",
        "mv",
        "rm",
        "tail",
        "wc"
      ]
    },
    "release": {
      "portable": [
        "awk",
        "bash",
        "diff",
        "find",
        "git",
        "gitleaks",
        "grep",
        "head",
        "jq",
        "mkdir",
        "mktemp",
        "od",
        "printenv",
        "sed",
        "sort",
        "stat",
        "tar"
      ],
      "ci": [
        "shellcheck"
      ],
      "full": [
        "claude",
        "codex"
      ]
    }
  },
  "toolchain": {
    "gitleaks": {
      "version": "8.30.1",
