{
  "schemaVersion": 2,
  "distribution": {
    "marketplaceName": "nsoul",
    "displayName": "nSOUL",
    "pluginName": "nott",
    "version": "2.0.0",
    "developer": "menot-you",
    "repository": "https://github.com/menot-you/nsoul",
    "license": "AGPL-3.0-only",
    "authorityDecision": "d25-public-distribution-boundary"
  },
  "integrations": {
    "nmemory": {
      "launcher": "bin/nmemory-mcp",
      "override": "NOTT_NMEMORY_BIN",
      "executable": "nmemory"
    },
    "nbrowser": {
      "launcher": "bin/nbrowser-mcp",
      "override": "NOTT_NBROWSER_BIN",
      "executable": "nbrowser-mcp"
    }
  },
  "runtimeDependencies": {
    "plugin": {
